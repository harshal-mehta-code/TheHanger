# Cloud sync is optional. Leave these unset and The Hanger runs exactly as it
# always has — a private, local-only closet in one browser.
#
# To turn on accounts and sync across devices:
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL editor (Dashboard -> SQL Editor)
#   3. Copy Project URL and the anon/public key from Settings -> API
#   4. Set both here for local dev, and in Vercel -> Settings -> Environment
#      Variables for the deployed app, then redeploy.
#
# Both values are safe to expose in the browser: the anon key only ever grants
# what row-level security allows, which is "your own rows and nobody else's".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
